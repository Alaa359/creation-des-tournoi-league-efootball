// Déploiement Cloudflare — site complet (SPA React + API Worker + stockage KV)
{
  "name": "championnat-rafraf",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-01-15",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "STATE",
      "id": "1f87c67d2e4f4558b889a02d40cb7fd8"
    }
  ],
  "assets": {
    "directory": "./web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Secrets (ADMIN_PASSWORD, SESSION_SECRET) : `npx wrangler secret put ADMIN_PASSWORD`
  // en production, et fichier .dev.vars ignoré par git en local.
  "vars": {}
}
